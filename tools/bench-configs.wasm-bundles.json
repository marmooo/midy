[
  {
    "name": "wasm",
    "bundle": "wasm",
    "set": {
      "cacheMode": "segment",
      "debug": true,
      "mixParallelMaxParts": 1
    }
  },
  {
    "name": "wasm-simd",
    "bundle": "wasm-simd",
    "set": {
      "cacheMode": "segment",
      "debug": true,
      "mixParallelMaxParts": 1
    }
  },
  {
    "name": "wasm-threads",
    "bundle": "wasm-threads",
    "set": {
      "cacheMode": "segment",
      "debug": true,
      "mixParallelMaxParts": 4,
      "workerPoolSize": 4,
      "useWorkerTypedArrayMix": true
    }
  },
  {
    "name": "wasm-threaded-simd",
    "bundle": "wasm-threaded-simd",
    "set": {
      "cacheMode": "segment",
      "debug": true,
      "mixParallelMaxParts": 4,
      "workerPoolSize": 4,
      "useWorkerTypedArrayMix": true
    }
  },
  {
    "name": "wasm-threads-serial",
    "bundle": "wasm-threads",
    "set": {
      "cacheMode": "segment",
      "debug": true,
      "mixParallelMaxParts": 1
    }
  },
  {
    "name": "wasm-threaded-simd-serial",
    "bundle": "wasm-threaded-simd",
    "set": {
      "cacheMode": "segment",
      "debug": true,
      "mixParallelMaxParts": 1
    }
  }
]

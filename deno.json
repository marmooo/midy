{
  "compilerOptions": {
    "lib": ["deno.ns", "dom", "es2022"]
  },
  "imports": {
    "@deno/dnt": "jsr:@deno/dnt@^0.44.0",
    "@luca/esbuild-deno-loader": "jsr:@luca/esbuild-deno-loader@^0.11.1",
    "@marmooo/soundfont": "npm:@marmooo/soundfont@^0.3.4",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@wasm-audio-decoders/ogg-vorbis": "npm:@wasm-audio-decoders/ogg-vorbis@^0.1.20",
    "esbuild": "npm:esbuild@^0.28.2",
    "midi-file": "npm:midi-file@^1.2.4",
    "web-audio-api": "npm:web-audio-api@^1.6.0"
  },
  "tasks": {
    "build": "deno task build:js && deno task build:wasm && deno task build:wasm-simd && deno task build:wasm-threads",
    "build:js": "deno run -RWE --allow-run build.ts --target=js",
    "build:wasm": "deno run -RWE --allow-run build.ts --target=wasm",
    "build:wasm-simd": "deno run -RWE --allow-run build.ts --target=wasm-simd",
    "build:wasm-threads": "deno run -RWE --allow-run build.ts --target=wasm-threads",
    "build:wasm-core": "bash wasm/build.sh && deno run -A wasm/scripts/embed_wasm.ts",
    "bench:native": "bash wasm/build.sh",
    "build:all": "deno task build:wasm-core && deno task build"
  },
  "exclude": ["dist", ".cache"]
}
